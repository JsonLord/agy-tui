# ==============================================================================
# agy-argus-hybrid Environment Configuration Example
# ==============================================================================
# Copy this file to .env before starting the runtime.
# DO NOT commit .env files containing real secret keys or passwords.

# ------------------------------------------------------------------------------
# 1. Official AGY Cloud Gemini & Model Configuration
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
AGY_SUPERVISOR_MODEL=gemini-2.5-pro
AGY_DISPATCH_MODEL=gemini-2.5-flash

# Helmholtz Model Fallback (Optional)
HELMHOLTZ_API_KEY=your_helmholtz_api_key_here
HELMHOLTZ_SUPERVISOR_MODEL=alias-mimo-v2.6-pro
HELMHOLTZ_DISPATCH_MODEL=alias-mimo-v2.6-flash

# ------------------------------------------------------------------------------
# 2. Argus MCP Adapter Configuration
# ------------------------------------------------------------------------------
ARGUS_MCP_ENABLED=true
ARGUS_MCP_URL=http://localhost:8090/mcp
ARGUS_API_KEY=your_argus_api_key_here

# ------------------------------------------------------------------------------
# 3. ClickUp MCP Integration Configuration
# ------------------------------------------------------------------------------
CLICKUP_MCP_ENABLED=false
CLICKUP_API_KEY=pk_your_clickup_api_key_here
CLICKUP_WORKSPACE_ID=your_workspace_id_here
CLICKUP_DEFAULT_LIST_ID=your_list_id_here

# ------------------------------------------------------------------------------
# 4. Workstation OpenCode & Native Per-Workspace Model Selection
# ------------------------------------------------------------------------------
OPENCODE_SERVER_URL=http://127.0.0.1:4096
OPENCODE_PROVIDER=anthropic
OPENCODE_MODEL=claude-3-7-sonnet
OPENCODE_CONFIG_DIR=container
OPENCODE_SUPERVISE_PATH=scripts/opencode-supervise

# ------------------------------------------------------------------------------
# 5. Tool Router & Supervisor Lifecycle Settings
# ------------------------------------------------------------------------------
NEEDLE_ROUTER_URL=https://leon4gr45-needle.hf.space
SUPERVISOR_STALL_SECONDS=900
SUPERVISOR_REPEAT_LIMIT=3
SUPERVISOR_MAX_RESTARTS=1

# ------------------------------------------------------------------------------
# 6. Runtime Storage & Portability
# ------------------------------------------------------------------------------
AGY_STATE_ROOT=state
AGY_RELEASE_ROOT=.
HEALTH_PORT=8080
